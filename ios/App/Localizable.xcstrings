    "Box, 4-7-8, Relax and Coherent, or make your own.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax y Coherent, o crea el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax et Coherent, ou créez le vôtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax und Coherent, oder erstelle dein eigenes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax e Coherent, oppure creane uno tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax e Coherent, ou crie o seu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックス、4-7-8、リラックス、コヒーレント。自分のパターンも作れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박스, 4-7-8, 릴렉스, 코히어런트 중에서 고르거나 직접 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方框、4-7-8、放松、协调，也可以自己创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方框、4-7-8、放鬆、協調，也可以自己建立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Box, 4-7-8, Relax и Coherent, или создайте свой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنماط جاهزة، أو أنشئ نمطك الخاص."
          }
        }
      }
    },
    "Feel each breath": {
      "extractionState": "manual",
      "localizations": {
