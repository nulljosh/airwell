            "value": "Sinta cada respiração"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸を感じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호흡을 느껴보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感受每一次呼吸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感受每一次呼吸"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почувствуйте каждый вдох"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشعر بكل نفس"
          }
        }
      }
    },
    "A soft tap marks every change, so your eyes can rest.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque suave marca cada cambio, así tus ojos descansan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un léger tapotement marque chaque changement, vos yeux peuvent se reposer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Tippen markiert jeden Wechsel, deine Augen können ruhen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieve tocco segna ogni cambio, così gli occhi si riposano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque suave marca cada mudança, e seus olhos descansam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替わるたびにやさしい振動。目を休められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바뀔 때마다 부드러운 진동이 울려 눈을 쉴 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次切换都有轻柔的触感，让眼睛休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次切換都有輕柔的觸感，讓眼睛休息。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкий отклик отмечает каждую смену, глаза отдыхают."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرة خفيفة عند كل تغيير ليرتاح بصرك."
          }
        }
      }
    },
    "Keep a streak": {
      "extractionState": "manual",
      "localizations": {
