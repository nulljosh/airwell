            "state": "translated",
            "value": "Держите серию"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على سلسلتك"
          }
        }
      }
    },
    "Sessions are logged so you can watch the days add up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones se registran para que veas cómo suman los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances sont enregistrées pour voir les jours s'additionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen werden gespeichert, damit du die Tage zählen siehst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni vengono registrate per vedere i giorni accumularsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões ficam registradas para você ver os dias somarem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが記録され、日々の積み重ねが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 기록되어 날이 쌓이는 모습을 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话会被记录，让你看到天数累积。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段會被記錄，讓你看到天數累積。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы записываются, и вы видите, как копятся дни."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل الجلسات لترى الأيام تتراكم."
          }
        }
      }
    },
    "Everything stays on this device. No account, no tracking.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. Sin cuenta, sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Pas de compte, pas de suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Kein Konto, kein Tracking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo dispositivo. Nessun account, nessun tracciamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste dispositivo. Sem conta, sem rastreamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのデバイス内に保存されます。アカウントも追跡もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 이 기기에만 저장됩니다. 계정도 추적도 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都保存在此设备上。无需账号，不做追踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都儲存在此裝置上。無需帳號，不做追蹤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на устройстве. Без аккаунта и без слежки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هذا الجهاز. بلا حساب وبلا تتبّع."
          }
        }
      }
    },
